# ------------------------------------------------------------
# CodeKita — Environment Configuration
# Copy this file to .env and adjust for your environment.
# Never commit real secrets to version control.
# ------------------------------------------------------------

# Application
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173
API_BASE_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://codekita:codekita@localhost:5432/codekita?schema=public"
SHADOW_DATABASE_URL="postgresql://codekita:codekita@localhost:5432/codekita_shadow?schema=public"

# Authentication (sessions)
SESSION_SECRET=replace-with-a-strong-random-secret-in-production
SESSION_MAX_AGE=86400000
SESSION_NAME=codekita_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ARGON2ID_MEMORY_COST=65536
ARGON2ID_TIME_COST=3
ARGON2ID_PARALLELISM=4

# OIDC / OAuth 2.0 (optional — foundation only, not enforced)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/oidc/callback

# CORS
CORS_ORIGIN=http://localhost:5173

# OpenAPI / Swagger
ENABLE_SWAGGER=true