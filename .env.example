# ------------------------------------------------------------
# CodeKita — Environment Configuration
# Copy this file to .env and adjust for your environment.
# Never commit real secrets to version control.
# ------------------------------------------------------------

# Application
# Public frontend development URL. /api is appended automatically.
# Production builds default to /api on a Node.js host/reverse proxy.
# For separate hosting set VITE_API_URL in .env.production.local to the HTTPS API origin.
VITE_API_URL=http://localhost:3000
# All DATABASE_*, SESSION_*, OIDC_* values below are server-only; never use VITE_ for secrets.
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173
API_BASE_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=5"
DIRECT_URL="postgresql://USER:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# Authentication (sessions)
# Local full-stack startup generates this in ignored .env.local when absent.
# Deployed environments should inject a stable value from their secret manager.
SESSION_SECRET=
SESSION_MAX_AGE=86400000
SESSION_NAME=codekita_session
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ARGON2ID_MEMORY_COST=65536
ARGON2ID_TIME_COST=3
ARGON2ID_PARALLELISM=4

# Operator-only administrator setup (never expose these with a VITE_ prefix).
# Inject via your secret manager or a temporary shell environment; do not commit.
# admin:bootstrap creates an admin ONLY when none exists. Recovery of an existing
# admin requires the explicit --recover-existing flag and matching ADMIN_EMAIL.
# ADMIN_USERNAME may be "admin"; use a real, unique ADMIN_EMAIL.
# ADMIN_EMAIL=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# OIDC / OAuth 2.0 (optional — foundation only, not enforced)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/oidc/callback

# CORS
# On the production Node host: CORS_ORIGIN=https://codekita.web.id
# Use COOKIE_SECURE=true; for a cross-site API also set COOKIE_SAME_SITE=none.
# Prefer a same-site API subdomain: browsers may block third-party cookies.
CORS_ORIGIN=http://localhost:5173

# OpenAPI / Swagger
ENABLE_SWAGGER=true
TRUST_PROXY=0