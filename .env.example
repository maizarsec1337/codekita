# ------------------------------------------------------------
# CodeKita — Environment Configuration
# Copy this file to .env and adjust for your environment.
# Never commit real secrets to version control.
# ------------------------------------------------------------

# Application
# Public frontend: leave empty until a real separately hosted HTTPS API is available.
# Set in .env.production.local before npm run build. Include the backend /api prefix.
# VITE_API_URL=
# All DATABASE_*, SESSION_*, OIDC_* values below are server-only; never use VITE_ for secrets.
NODE_ENV=development
PORT=3000
FRONTEND_PORT=5173
API_BASE_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://codekita:codekita@localhost:5432/codekita?schema=public"
SHADOW_DATABASE_URL="postgresql://codekita:codekita@localhost:5432/codekita_shadow?schema=public"

# Authentication (sessions)
# Local full-stack startup generates this in ignored .env.local when absent.
# Deployed environments should inject a stable value from their secret manager.
SESSION_SECRET=replace-with-a-strong-random-secret-in-production
SESSION_MAX_AGE=86400000
SESSION_NAME=codekita_session
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ARGON2ID_MEMORY_COST=65536
ARGON2ID_TIME_COST=3
ARGON2ID_PARALLELISM=4

# OIDC / OAuth 2.0 (optional — foundation only, not enforced)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=http://localhost:3000/api/auth/oidc/callback

# CORS
# On the production Node host: CORS_ORIGIN=https://codekita.web.id
# Use COOKIE_SECURE=true; for a cross-site API also set COOKIE_SAME_SITE=none.
# Prefer a same-site API subdomain: browsers may block third-party cookies.
CORS_ORIGIN=http://localhost:5173

# OpenAPI / Swagger
ENABLE_SWAGGER=true