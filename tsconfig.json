{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@codekita/shared": ["./packages/shared/src/index.ts"],
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src/**/*", "packages/shared/src/**/*"],
  "exclude": ["src/server", "src/common", "node_modules", "dist"]
}