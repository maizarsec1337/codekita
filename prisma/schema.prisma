generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  username     String?     @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  emailVerified Boolean    @default(false)
  isActive     Boolean     @default(true)
  roles        UserRole[]
  sessions     Session[]
  enrollments  Enrollment[]
  xpEvents     XpEvent[]
  profile      Profile?
  courses      Course[] @relation("InstructorCourses")
  quizResults  QuizResult[]
  labDrafts    LabDraft[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
}

model UserRole {
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String @db.Uuid
  role      Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId    String @db.Uuid
  assignedAt DateTime @default(now())
  @@id([userId, roleId])
}

model Course {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  slug        String        @unique
  description String?
  coverImage  String?
  isPublished Boolean       @default(false)
  academy     String        @default("programming")
  difficulty  String        @default("Beginner")
  estimatedMinutes Int      @default(60)
  skills      String[]      @default([])
  prerequisites String[]    @default([])
  categoryId  String?       @db.Uuid
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  instructorId String?      @db.Uuid
  instructor  User?         @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: SetNull)
  modules     CourseModule[]
  enrollments Enrollment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CourseModule {
  id        String   @id @default(uuid()) @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String   @db.Uuid
  title     String
  slug      String?  @unique
  order     Int
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lesson {
  id          String   @id @default(uuid()) @db.Uuid
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId    String   @db.Uuid
  title       String
  slug        String?
  objectives  String[] @default([])
  assessment  Json?
  content     String?
  videoUrl    String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  progress    LearningProgress[]
  quiz        Quiz?
  @@unique([moduleId, slug])
}

model Enrollment {
  id        String   @id @default(uuid()) @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String   @db.Uuid
  enrolledAt DateTime @default(now())
  progress  LearningProgress[]
  certificate Certificate?
  @@unique([userId, courseId])
}

model LearningProgress {
  id           String   @id @default(uuid()) @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String   @db.Uuid
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String   @db.Uuid
  completed    Boolean  @default(false)
  completedAt  DateTime?
  notes        String   @default("")
  bookmarked   Boolean  @default(false)
  updatedAt    DateTime @updatedAt
  @@unique([enrollmentId, lessonId])
}

model XpEvent {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey  String
  amount    Int
  createdAt DateTime @default(now())
  @@unique([userId, eventKey])
  @@index([userId, createdAt])
}

model Certificate {
  id           String @id @default(uuid()) @db.Uuid
  enrollmentId String @unique @db.Uuid
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  title        String
  issuedAt     DateTime @default(now())
}

model Profile {
  userId      String @id @db.Uuid
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String @default("")
  bio         String @default("")
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
}

model Permission {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid
  role         Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Category {
  id          String @id @default(uuid()) @db.Uuid
  slug        String @unique
  name        String
  description String @default("")
  isActive    Boolean @default(true)
  courses     Course[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quiz {
  id           String @id @default(uuid()) @db.Uuid
  lessonId     String @unique @db.Uuid
  lesson       Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question     String
  options      String[]
  correctIndex Int
  results      QuizResult[]
  updatedAt    DateTime @updatedAt
}

model QuizResult {
  id         String @id @default(uuid()) @db.Uuid
  quizId     String @db.Uuid
  quiz       Quiz @relation(fields: [quizId], references: [id], onDelete: Restrict)
  userId     String @db.Uuid
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  answer     Int
  passed     Boolean
  createdAt  DateTime @default(now())
  @@index([userId, createdAt])
}

model Lab {
  id          String @id
  academy     String
  title       String
  language    String
  duration    String
  description String
  starter     String
  sample      String
  objectives  String[]
  hint        String
  isPublished Boolean @default(false)
  drafts      LabDraft[]
}

model LabDraft {
  userId    String @db.Uuid
  labId     String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lab       Lab @relation(fields: [labId], references: [id], onDelete: Cascade)
  code      String
  language  String
  updatedAt DateTime @updatedAt
  @@id([userId, labId])
}

model CurriculumTemplate {
  slug    String @id
  content Json
}