{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "../../dist/server",
    "rootDir": "src",
    "declaration": true,
    "types": ["node"],
    "noEmit": false,
    "esModuleInterop": true,
    "paths": {
      "@codekita/shared": ["../packages/shared/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "prisma", "test"]
}