# Copy outside the release to /etc/codekita/codekita.env; restrict to root:codekita 0640.
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://codekita.web.id
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
ENABLE_SWAGGER=false
TRUST_PROXY=1
# Set both URLs to the local PostgreSQL database; URL-encode special characters.
DATABASE_URL=
DIRECT_URL=
# Set a stable, independently generated random secret (at least 32 random bytes).
SESSION_SECRET=