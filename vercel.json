{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api(?:/|$)|assets(?:/|$)|.*\\..*).*)", "destination": "/index.html" }
  ]
}