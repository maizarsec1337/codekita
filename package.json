{
  "name": "codekita",
  "private": true,
  "description": "CodeKita — Educational Technology Platform (Modular Monolith)",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite --mode static --port 5173 --strictPort",
    "dev:fullstack": "node scripts/dev.mjs",
    "dev:frontend": "vite --mode static --port 5173 --strictPort",
    "build:static": "npm run build",
    "build:infinityfree": "npm run build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "preview:static": "npm run preview",
    "build:frontend": "npm run build",
    "build:backend": "node scripts/build-backend.mjs",
    "build:fullstack": "npm run build:backend && npm run build",
    "verify:infinityfree": "node scripts/verify-infinityfree.mjs",
    "typecheck:frontend": "tsc -p tsconfig.json --noEmit",
    "build": "npm run typecheck:frontend && node scripts/generate-error-documents.mjs && vite build && npm run verify:infinityfree",
    "generate:error-documents": "node scripts/generate-error-documents.mjs",
    "env:ensure": "node scripts/ensure-environment.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:frontend": "eslint --config eslint.frontend.config.mjs src packages/shared/src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "postinstall": "prisma generate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.0.5",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.2",
    "@hookform/resolvers": "^3.10.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.3.2",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.66.7",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "framer-motion": "^12.4.2",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "lucide-react": "^1.63.0",
    "pino": "^9.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.1.13",
    "react-router-dom": "^6.28.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  }
}