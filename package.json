{
  "name": "codekita",
  "private": true,
  "description": "CodeKita — Educational Technology Platform (Modular Monolith)",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "node scripts/unified-build.mjs",
    "start": "node dist/server/main.js",
    "lint": "pnpm -r run lint && eslint . --max-warnings 0",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write frontend/**/*.{ts,tsx,js,json,md} backend/**/*.{ts,js,json,md} packages/shared/**/*.{ts,js,json,md} scripts/**/*.{js,mjs} docs/**/*.md"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "eslint": "^9.18.0",
    "@eslint/js": "^9.18.0",
    "typescript-eslint": "^8.22.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "vitest": "^2.1.8"
  }
}